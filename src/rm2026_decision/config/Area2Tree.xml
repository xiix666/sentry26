<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Area2Tree">
    <ReactiveFallback>
      <Precondition else="FAILURE"
                    if="(@center_status == 0 || @center_status == 1) &amp;&amp; @sentry_hp &gt; 300 &amp;&amp; @bullets_allowance &gt; 200"
                    _while="(@center_status == 0 || @center_status == 1) &amp;&amp; @sentry_hp &gt; 300 &amp;&amp; @bullets_allowance &gt; 200">
        <GoToArea3 target_pose="{@goto_area3}"
                   timeout="15.0"
                   tolerance="0.2"
                   ros_node="{@ros_node}"
                   current_pose_x="{@current_pose_x}"
                   current_pose_y="{@current_pose_y}"
                   nav_goal="{@nav_goal}"
                   nav_goalOut="{@nav_goal}"
                   nav_goal_requested="{@nav_goal_requested}"
                   _while="@current_area == 2 &amp;&amp; (@center_status == 0 || @center_status == 1) &amp;&amp; @sentry_hp &gt; 300 &amp;&amp; @bullets_allowance &gt; 200"/>
      </Precondition>
      <Precondition else="FAILURE"
                    if="@current_area == 2"
                    _while="@current_area == 2">
        <AsyncSequence>
          <Area2YellowTimer yellow_point="{@area2_yellow_point}"
                            robot_x="{@current_pose_x}"
                            robot_y="{@current_pose_y}"
                            stay_duration="8.0"
                            tolerance="0.2"
                            ros_node="{@ros_node}"
                            _while="@current_area == 2"/>
          <GoToArea3 target_pose="{@goto_area3}"
                     timeout="15.0"
                     tolerance="0.2"
                     ros_node="{@ros_node}"
                     current_pose_x="{@current_pose_x}"
                     current_pose_y="{@current_pose_y}"
                   nav_goal="{@nav_goal}"
                   nav_goalOut="{@nav_goal}"
                   nav_goal_requested="{@nav_goal_requested}"
                   _while="@current_area == 2"/>
        </AsyncSequence>
      </Precondition>
      <GoToArea2yellow target_pose="{@area2_yellow_point}"
                       timeout="15.0"
                       tolerance="0.2"
                       ros_node="{@ros_node}"
                       current_pose_x="{@current_pose_x}"
                       current_pose_y="{@current_pose_y}"
                       nav_goal="{@nav_goal}"
                       nav_goalOut="{@nav_goal}"
                       nav_goal_requested="{@nav_goal_requested}"
                       _while="@current_area == 2"/>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="Area2YellowTimer"
               editable="true">
      <input_port name="yellow_point"/>
      <input_port name="robot_x"
                  default="@current_pose_x"/>
      <input_port name="robot_y"
                  default="@current_pose_y"/>
      <input_port name="stay_duration"
                  default="10.0"/>
      <input_port name="tolerance"
                  default="0.2"/>
      <input_port name="ros_node"/>
    </Condition>
    <Action ID="GoToArea2yellow"
            editable="true">
      <input_port name="target_pose"/>
      <input_port name="timeout"
                  default="15.0"/>
      <input_port name="tolerance"
                  default="0.2"/>
      <input_port name="ros_node"/>
      <input_port name="current_pose_x"
                  default="@current_pose_x"/>
      <input_port name="current_pose_y"
                  default="@current_pose_y"/>
      <input_port name="nav_goal"/>
      <output_port name="nav_goalOut"/>
      <output_port name="nav_goal_requested"/>
    </Action>
    <Action ID="GoToArea3"
            editable="true">
      <input_port name="target_pose"/>
      <input_port name="timeout"
                  default="15.0"/>
      <input_port name="tolerance"
                  default="0.2"/>
      <input_port name="ros_node"/>
      <input_port name="current_pose_x"
                  default="@current_pose_x"/>
      <input_port name="current_pose_y"
                  default="@current_pose_y"/>
      <input_port name="nav_goal"/>
      <output_port name="nav_goalOut"/>
      <output_port name="nav_goal_requested"/>
    </Action>
  </TreeNodesModel>

</root>

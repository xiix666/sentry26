<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="HighP">
    <ReactiveFallback>
      <Precondition else="FAILURE"
                    if="@sentry_hp &lt; 200"
                    _while="@sentry_hp &lt; 200">
        <StayAtSupplyPoint supply_point_location="{@supply_point_location}"
                           timeout="15.0"
                           tolerance="0.2"
                           ros_node="{@ros_node}"
                           current_pose_x="{@current_pose_x}"
                           current_pose_y="{@current_pose_y}"
                           nav_goal="{@nav_goal}"
                           nav_goalOut="{@nav_goal}"
                           nav_goal_requested="{@nav_goal_requested}"
                           _while="@sentry_hp &lt; 200"/>
      </Precondition>
      <Precondition else="FAILURE"
                    if="@area4_yellow_patrol_reached == 0"
                    _while="@area4_yellow_patrol_reached == 0">
        <GoToArea4yellow target_pose="{@area4_yellow_patrol}"
                         timeout="5.0"
                         tolerance="0.2"
                         ros_node="{@ros_node}"
                         current_pose_x="{@current_pose_x}"
                         current_pose_y="{@current_pose_y}"
                         nav_goal="{@nav_goal}"
                         nav_goalOut="{@nav_goal}"
                         nav_goal_requested="{@nav_goal_requested}"
                         _while="@area4_yellow_patrol_reached == 0"/>
      </Precondition>
      <Precondition else="FAILURE"
                    if="@bullets_allowance &lt; 50"
                    _while="@bullets_allowance &lt; 50">
        <GoToArea4yellow target_pose="{@area4_yellow_patrol}"
                         timeout="15.0"
                         tolerance="0.2"
                         ros_node="{@ros_node}"
                         current_pose_x="{@current_pose_x}"
                         current_pose_y="{@current_pose_y}"
                         nav_goal="{@nav_goal}"
                         nav_goalOut="{@nav_goal}"
                         nav_goal_requested="{@nav_goal_requested}"
                         _while="@bullets_allowance &lt; 50"/>
      </Precondition>
      
      <SubTree ID="AreaMain"/>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="Area1Patrol3"
            editable="true">
      <input_port name="point1"/>
      <input_port name="point2"/>
      <input_port name="point3"/>
      <input_port name="timeout"
                  default="15.0"/>
      <input_port name="tolerance"
                  default="0.1"/>
      <input_port name="ros_node"/>
      <input_port name="current_pose_x"
                  default="@current_pose_x"/>
      <input_port name="current_pose_y"
                  default="@current_pose_y"/>
      <input_port name="nav_goal"/>
      <output_port name="nav_goalOut"/>
      <output_port name="nav_goal_requested"/>
    </Action>
    <Action ID="GoToArea4yellow"
            editable="true">
      <input_port name="target_pose"/>
      <input_port name="timeout"
                  default="15.0"/>
      <input_port name="tolerance"
                  default="0.1"/>
      <input_port name="ros_node"/>
      <input_port name="current_pose_x"
                  default="@current_pose_x"/>
      <input_port name="current_pose_y"
                  default="@current_pose_y"/>
      <input_port name="nav_goal"/>
      <output_port name="nav_goalOut"/>
      <output_port name="nav_goal_requested"/>
    </Action>
    <Action ID="StayAtSupplyPoint"
            editable="true">
      <input_port name="supply_point_location"/>
      <input_port name="timeout"
                  default="15.0"/>
      <input_port name="tolerance"
                  default="0.2"/>
      <input_port name="ros_node"/>
      <input_port name="current_pose_x"
                  default="@current_pose_x"/>
      <input_port name="current_pose_y"
                  default="@current_pose_y"/>
      <input_port name="nav_goal"/>
      <output_port name="nav_goalOut"/>
      <output_port name="nav_goal_requested"/>
    </Action>
  </TreeNodesModel>

</root>

<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Area0Tree">
    <ReactiveFallback>
      <Precondition else="FAILURE"
                    if="@sentry_hp &lt; 350"
                    _while="@sentry_hp &lt; 350">
        <StayAtSupplyPoint supply_point_location="{@supply_point_location}"
                           timeout="15.0"
                           tolerance="0.2"
                           ros_node="{@ros_node}"
                           current_pose_x="{@current_pose_x}"
                           current_pose_y="{@current_pose_y}"
                           nav_goal="{@nav_goal}"
                           nav_goalOut="{@nav_goal}"
                           nav_goal_requested="{@nav_goal_requested}"
                           _while="(@current_area == 0 || @current_area == -1) &amp;&amp; @sentry_hp &lt; 350"/>
      </Precondition>
      <Precondition else="FAILURE"
                    if="@enemy_distance_min &gt;= 0 &amp;&amp; @enemy_distance_min &lt; 4.0"
                    _while="@enemy_distance_min &gt;= 0 &amp;&amp; @enemy_distance_min &lt; 4.0">
        <StayAtSupplyPoint supply_point_location="{@supply_point_location}"
                           timeout="15.0"
                           tolerance="0.2"
                           ros_node="{@ros_node}"
                           current_pose_x="{@current_pose_x}"
                           current_pose_y="{@current_pose_y}"
                           nav_goal="{@nav_goal}"
                           nav_goalOut="{@nav_goal}"
                           nav_goal_requested="{@nav_goal_requested}"
                           _while="@current_area == 0 || @current_area == -1"/>
      </Precondition>
      <Precondition else="FAILURE"
                    if="@sentry_hp &gt;= 350"
                    _while="@sentry_hp &gt;= 350">
        <GoToArea1 target_pose="{@goto_area1}"
                   timeout="5.0"
                   tolerance="0.2"
                   ros_node="{@ros_node}"
                   current_pose_x="{@current_pose_x}"
                   current_pose_y="{@current_pose_y}"
                   nav_goal="{@nav_goal}"
                   nav_goalOut="{@nav_goal}"
                   nav_goal_requested="{@nav_goal_requested}"
                   _while="(@current_area == 0 || @current_area == -1) &amp;&amp; @sentry_hp &gt;= 350"/>
      </Precondition>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="GoToArea1"
            editable="true">
      <input_port name="target_pose"/>
      <input_port name="timeout"
                  default="15.0"/>
      <input_port name="tolerance"
                  default="0.2"/>
      <input_port name="ros_node"/>
      <input_port name="current_pose_x"
                  default="@current_pose_x"/>
      <input_port name="current_pose_y"
                  default="@current_pose_y"/>
      <input_port name="nav_goal"/>
      <output_port name="nav_goalOut"/>
      <output_port name="nav_goal_requested"/>
    </Action>
    <Action ID="StayAtSupplyPoint"
            editable="true">
      <input_port name="supply_point_location"/>
      <input_port name="timeout"
                  default="15.0"/>
      <input_port name="tolerance"
                  default="0.2"/>
      <input_port name="ros_node"/>
      <input_port name="current_pose_x"
                  default="@current_pose_x"/>
      <input_port name="current_pose_y"
                  default="@current_pose_y"/>
      <input_port name="nav_goal"/>
      <output_port name="nav_goalOut"/>
      <output_port name="nav_goal_requested"/>
    </Action>
  </TreeNodesModel>

</root>

<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" project_name="Project">
    <include path="TestPatrol3.xml"/>
    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Action ID="Area1Patrol3" editable="true">
            <input_port name="point1"/>
            <input_port name="point2"/>
            <input_port name="point3"/>
            <input_port name="timeout"/>
            <input_port name="tolerance"/>
            <input_port name="ros_node"/>
            <input_port name="current_pose_x"/>
            <input_port name="current_pose_y"/>
            <input_port name="nav_goal"/>
            <input_port name="nav_goalOut"/>
            <input_port name="nav_goal_requested"/>
        </Action>
        <Action ID="StayAtSupplyPoint" editable="true">
            <input_port name="supply_point_location"/>
            <input_port name="timeout"/>
            <input_port name="tolerance"/>
            <input_port name="ros_node"/>
            <input_port name="current_pose_x"/>
            <input_port name="current_pose_y"/>
            <input_port name="nav_goal"/>
            <input_port name="nav_goalOut"/>
            <input_port name="nav_goal_requested"/>
        </Action>
    </TreeNodesModel>
</root>

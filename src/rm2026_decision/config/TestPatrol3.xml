<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="TestPatrol3">
    <ReactiveFallback>
      <Precondition else="FAILURE"
                    if="@sentry_hp &lt; 200"
                    _while="@sentry_hp &lt; 200">
        <StayAtSupplyPoint supply_point_location="{@supply_point_location}"
                           timeout="10.0"
                           tolerance="0.2"
                           ros_node="{@ros_node}"
                           current_pose_x="{@current_pose_x}"
                           current_pose_y="{@current_pose_y}"
                           nav_goal="{@nav_goal}"
                           nav_goalOut="{@nav_goal}"
                           nav_goal_requested="{@nav_goal_requested}"
                           _while="@sentry_hp &lt; 200"/>
      </Precondition>
      <Precondition else="FAILURE"
                    if="@sentry_hp &gt;=200"
                    _while="@sentry_hp &gt;=200">
        <Area1Patrol3 point1="{@area1_point1}"
                      point2="{@area1_point2}"
                      point3="{@area1_point3}"
                      timeout="8.0"
                      tolerance="0.1"
                      ros_node="{@ros_node}"
                      current_pose_x="{@current_pose_x}"
                      current_pose_y="{@current_pose_y}"
                      nav_goal="{@nav_goal}"
                      nav_goalOut="{@nav_goal}"
                      nav_goal_requested="{@nav_goal_requested}"/>
      </Precondition>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="Area1Patrol3"
            editable="true">
      <input_port name="point1"/>
      <input_port name="point2"/>
      <input_port name="point3"/>
      <input_port name="timeout"/>
      <input_port name="tolerance"/>
      <input_port name="ros_node"/>
      <input_port name="current_pose_x"/>
      <input_port name="current_pose_y"/>
      <input_port name="nav_goal"/>
      <input_port name="nav_goalOut"/>
      <input_port name="nav_goal_requested"/>
    </Action>
    <Action ID="StayAtSupplyPoint"
            editable="true">
      <input_port name="supply_point_location"/>
      <input_port name="timeout"/>
      <input_port name="tolerance"/>
      <input_port name="ros_node"/>
      <input_port name="current_pose_x"/>
      <input_port name="current_pose_y"/>
      <input_port name="nav_goal"/>
      <input_port name="nav_goalOut"/>
      <input_port name="nav_goal_requested"/>
    </Action>
  </TreeNodesModel>

</root>

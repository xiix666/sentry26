<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="AreaMain">
    <ReactiveFallback>
      <Precondition else="FAILURE"
                    if="@current_area == 0 "
                    _while="@current_area == 0 ">
        <SubTree ID="Area0Tree"
                 _while="@current_area == 0 "/>
      </Precondition>
      <Precondition else="FAILURE"
                    if="@current_area == 1"
                    _while="@current_area == 1">
        <SubTree ID="Area1Tree"
                 _while="@current_area == 1"/>
      </Precondition>
      <Precondition else="FAILURE"
                    if="@current_area == 2"
                    _while="@current_area == 2">
        <SubTree ID="Area2Tree"
                 _while="@current_area == 2"/>
      </Precondition>
      <Precondition else="FAILURE"
                    if="@current_area == 3"
                    _while="@current_area == 3">
        <SubTree ID="Area3Tree"
                 _while="@current_area == 3"/>
      </Precondition>
      <Precondition else="FAILURE"
                    if="@current_area == 4"
                    _while="@current_area == 4">
        <SubTree ID="Area4Tree"
                 _while="@current_area == 4"/>
      </Precondition>
      <Precondition else="FAILURE"
                    if="@current_area &gt; 4"
                    _while="@current_area &gt; 4">
        <SubTree ID="Area5Tree"
                 _while="@current_area &gt; 4"/>
      </Precondition>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel/>

</root>
